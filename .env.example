# Copy to .env, fill in what you need, and run commands with `uv run --env-file .env ...` (or export these in your shell).

# fal.ai: keyframes, video clips, lip-sync, and posters (video/generate.py, video/poster/make_posters.py)
FAL_KEY=

# Only for the rejected ElevenLabs audio experiments in scripts/
ELEVENLABS_API_KEY=

# Only for video/notion/publish_notion.py (a Notion integration with access to your target database)
NOTION_API_TOKEN=
NOTION_API_VERSION=2026-03-11

# Only for scripts/ace_lyric_edit.py: a private scratch directory outside the repo (keeps transcripts of the original out of git)
SCRATCH=

# Optional: an ffmpeg build with libass for the compositor (defaults to the one bundled with imageio-ffmpeg)
# FFMPEG=
